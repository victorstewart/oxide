  "fault_families": [
    {"id": "startup-delay-payload-bloat", "injection": "Add the severity-fixed launch delay and bundled inert payload without changing visible work.", "risk_dimension_ids": ["startup"]},
    {"id": "main-thread-layout-stall", "injection": "Add severity-fixed synchronous layout work on the measured main-thread mutation path.", "risk_dimension_ids": ["layout"]},
    {"id": "text-fallback-shaping-slowdown", "injection": "Force the severity-fixed fallback and shaping penalty while preserving glyph output.", "risk_dimension_ids": ["text-shaping"]},
    {"id": "image-decode-upload-delay", "injection": "Add severity-fixed decode and upload delay while preserving the decoded image and texture.", "risk_dimension_ids": ["images-decode-upload"]},
    {"id": "list-devirtualization", "injection": "Increase retained offscreen list materialization by the severity-fixed row count.", "risk_dimension_ids": ["scrolling-virtualization"]},
    {"id": "dirty-region-expansion", "injection": "Expand every required dirty region by the severity-fixed factor without skipping logical mutations.", "risk_dimension_ids": ["mutation-damage"]},
    {"id": "extra-offscreen-effect-pass", "injection": "Encode the severity-fixed redundant offscreen effect work with identical final pixels.", "risk_dimension_ids": ["clipping-effects", "animation"]},
    {"id": "gpu-upload-churn", "injection": "Repeat severity-fixed texture uploads while preserving visible resources.", "risk_dimension_ids": ["images-decode-upload"]},
    {"id": "input-handler-delay", "injection": "Add the severity-fixed delay after trusted event receipt and before the state mutation.", "risk_dimension_ids": ["discrete-input"]},
    {"id": "focus-ime-breakage", "injection": "Break the severity-selected focus, committed-text, or selection invariant.", "risk_dimension_ids": ["focus-ime"]},
    {"id": "mount-teardown-leak", "injection": "Retain the severity-fixed allocation after each completed mount and teardown cycle.", "risk_dimension_ids": ["allocation-teardown"]},
    {"id": "idle-timer-wakeup", "injection": "Schedule the severity-fixed timer and renderer wakeup rate after the scene settles.", "risk_dimension_ids": ["idle-scheduling"]},
    {"id": "retained-resource-slope", "injection": "Retain the severity-fixed resource bytes per churn cycle.", "risk_dimension_ids": ["allocation-teardown"]},
    {"id": "visual-fidelity-reduction", "injection": "Half-size the severity-selected visible element or omit its matched effect.", "risk_dimension_ids": ["clipping-effects"]}
  ],
