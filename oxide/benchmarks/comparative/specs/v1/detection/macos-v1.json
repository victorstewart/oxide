  "risk_dimensions": [
    {"id": "startup", "description": "Process launch, bundle loading, first complete UI, and readiness."},
    {"id": "layout", "description": "Main-thread layout, invalidation, and geometry work."},
    {"id": "text-shaping", "description": "Fallback selection, shaping, rasterization, and growing text."},
    {"id": "images-decode-upload", "description": "Image decode, texture upload, residency, and churn."},
    {"id": "clipping-effects", "description": "Clips, shadows, blur, offscreen passes, and effect fidelity."},
    {"id": "scrolling-virtualization", "description": "Variable-layout scrolling, reuse, and bounded visible work."},
    {"id": "mutation-damage", "description": "Scoped mutation, dirty-region propagation, and redraw containment."},
    {"id": "animation", "description": "Elapsed-time animation, transition pacing, and compositor work."},
    {"id": "discrete-input", "description": "Trusted discrete input through the visible response."},
    {"id": "focus-ime", "description": "Focus ownership, committed text, selection, and IME semantics."},
    {"id": "allocation-teardown", "description": "Allocation pressure, mount/teardown cleanup, and recovery."},
    {"id": "idle-scheduling", "description": "Settled timers, wakeups, submissions, and scheduler silence."}
  ],
