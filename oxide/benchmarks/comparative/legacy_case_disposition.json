  "known_coverage_gaps": [
    {
      "risk_dimension": "idle_scheduling",
      "required_replacement_target": "idle.steady",
      "reason": "The legacy idle-animation method performs active work and cannot prove a settled no-timer idle path."
    },
    {
      "risk_dimension": "payload_delivery",
      "required_replacement_target": "startup.first-screen",
      "reason": "Legacy launch rows do not freeze payload bytes or delivery accounting."
    },
    {
      "risk_dimension": "multilingual_text_shaping",
      "required_replacement_target": "text.multilingual",
      "reason": "Legacy text rows do not cover the required CJK, Arabic RTL, emoji, fallback, and cold-atlas matrix."
    },
    {
      "risk_dimension": "visual_fidelity",
      "required_replacement_target": "correctness parity checkpoints",
      "reason": "Meaningful-output signatures are not canonical pixel parity or a fidelity-reduction detector."
    },
    {
      "risk_dimension": "accessibility_semantics",
      "required_replacement_target": "correctness accessibility fingerprint",
      "reason": "Legacy performance methods do not validate exact accessibility semantics."
    },
    {
      "risk_dimension": "offscreen_effect_attribution",
      "required_replacement_target": "effects.layers fault corpus",
      "reason": "Legacy effects sentinels do not prove detection of an added offscreen or backdrop pass."
    },
    {
      "risk_dimension": "retained_resource_slope",
      "required_replacement_target": "endurance.churn",
      "reason": "Legacy lifecycle rows do not establish the required retained-footprint slope and recovery deadline."
    }
  ],
